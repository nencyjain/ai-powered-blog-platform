# ========================================================
# AI-Powered Blog Platform - Environment Configuration Example
# ========================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env" in the root directory.
# 2. Replace the placeholder values with your real credentials.
# 3. Never commit your ".env" file to Git or share it publicly!

# Flask Secret Key (used for session signing)
SECRET_KEY=codec_training_project_secret_key_2026

# OpenAI API Key (Required for live AI generation)
# Get your key at: https://platform.openai.com/api-keys
# If left empty, the application will automatically run in DEMO MODE with sample blogs.
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (Default: gpt-4o-mini, or gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Optional: Force Demo Mode even if key exists (true / false)
FORCE_DEMO_MODE=false
